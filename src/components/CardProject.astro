---
import "@/styles/homelab-markdown.css";
import TechPill from "@/components/TechPill.astro";
import GithubIcon from "@/components/icons/Github.astro";

import { getWebLabel } from "@/getWebLabel";
import { getImgUrl } from "@/uri";
import { markdownToHtml } from "@/remark";

interface Props {
    title: string,
    // subtitle?: string,
    description?: string,
    descriptionHtml?: string,
    img: string,
    gh_link?: string,
    used_tech: string[],
}

const { title, description, descriptionHtml, img, gh_link, used_tech } =
    Astro.props;

const valueDescriptionHtml = descriptionHtml ? await markdownToHtml(descriptionHtml) : undefined;

const t = getWebLabel;
---

<article
    class="flex flex-col items-stretch border rounded-lg shadow md:flex-row w-full border-gray-700 bg-gray-800 group hover:bg-gray-700 transition-all duration-500 min-h-52"
>   
    <div class="min-w-48 w-full md:w-48 h-44 md:h-auto overflow-hidden rounded-t-lg md:rounded-t-none md:rounded-l-lg">
        <img
            class="rounded-t-lg w-full md:w-auto h-full object-cover md:rounded-t-none md:rounded-l-lg group-hover:scale-105 transform transition-all duration-500"
            src={getImgUrl(img)}
            alt={`${(title)} icon`}
        />
    </div>
    <div
        class="flex flex-col justify-between w-full py-4 px-4 leading-normal"
    >
        <div class="flex flex-row justify-between">
            <div class="mb-2">
                <h5 class="text-2xl font-bold tracking-tight text-white">
                    {(title)}
                </h5>
            </div>
            <ul class="flex flex-row justify-end gap-x-2">
                <li>
                    {
                        gh_link && (
                            <a
                                href={gh_link}
                                target="_blank"
                                class="flex flex-row gap-x-1 items-center rounded-xl py-1 px-2 border hover:bg-gray-800  transition-all duration-100"
                            >
                                <GithubIcon /> {t("projects-code")}
                            </a>
                        )
                    }
                </li>
            </ul>
        </div>
        {valueDescriptionHtml ? <div class="homelab-markdown my-3 font-normal text-gray-400 text-pretty text-justify" set:html={valueDescriptionHtml} /> : <p class="text-gray-400">{description}</p>}

        <div class="flex flex-wrap gap-2">
            {used_tech?.map((tech) => <TechPill tech={tech} />)}
        </div>
    </div>
</article>
