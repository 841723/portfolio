---
import { getImgUrl } from "@/uri";
import TechPill from "@/components/TechPill.astro";
import GithubIcon from "@/components/icons/Github.astro";
import LinkIcon from "@/components/icons/Link.astro";

import { getWebLabel } from "@/getWebLabel";

interface Props {
    title: string,
    // subtitle?: string,
    description: string,
    img: string,
    gh_link?: string,
    preview_link?: string,
    used_tech: string[],
}

const { title, description, img, gh_link, preview_link, used_tech } =
    Astro.props;

const t = getWebLabel;

---

<article
    class="flex flex-col items-center border rounded-lg shadow md:flex-row w-full border-gray-700 bg-gray-800 group hover:bg-gray-700 transition-all duration-500"
>
    <div class="min-w-48 w-full md:w-48 h-[232px] overflow-hidden rounded-lg ">
        <img
            class="object-cover rounded-t-lg w-full md:w-auto h-full md:aspect-square md:rounded-t-none md:rounded-l-lg group-hover:scale-105 transform transition-all duration-500"
            src={getImgUrl(img)}
            alt={`${(title)} icon`}
        />
    </div>

    <div
        class="flex flex-col justify-between md:h-[232px] min-h-44 w-full py-4 px-4 leading-normal"
    >
        <div class="flex flex-row justify-between">
            <div class="mb-2">
                <h5 class="text-2xl font-bold tracking-tight text-white">
                    {(title)}
                </h5>
                <!-- {subtitle && 
                    <h6 class="text-sm m-0 italic opacity-80"> 
                        {subtitle}
                    </h6>
                } -->
            </div>
            <ul class="flex flex-row justify-end gap-x-2">
                <li>
                    {
                        preview_link && (
                            <a
                                href={preview_link}
                                target="_blank"
                                class="flex flex-row gap-x-1 items-center rounded-xl py-1 px-2 border-1 hover:bg-gray-800  transition-all duration-100"
                            >
                                <LinkIcon /> {t("projects-preview")}
                            </a>
                        )
                    }
                </li>

                <li>
                    {
                        gh_link && (
                            <a
                                href={gh_link}
                                target="_blank"
                                class="flex flex-row gap-x-1 items-center rounded-xl py-1 px-2 border hover:bg-gray-800  transition-all duration-100"
                            >
                                <GithubIcon /> {t("projects-code")}
                            </a>
                        )
                    }
                </li>
            </ul>
        </div>
        <p class="my-3 font-normal text-gray-400 text-pretty text-justify">
            {(description)}
        </p>
        <div class="flex flex-wrap gap-2">
            {used_tech?.map((tech) => <TechPill tech={tech} />)}
        </div>
    </div>
</article>
